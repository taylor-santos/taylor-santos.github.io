{
  "rules": {
    "polls": {
      "$id": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['title', 'candidates'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "candidates": {
          "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" }
        },
        "$other": { ".validate": false }
      }
    },
    "votes": {
      "$id": {
        ".read": true,
        "$vid": {
          ".write": "!data.exists() && root.child('polls').child($id).exists()",
          ".validate": "newData.hasChildren(['name', 'ranking', 't'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "ranking": { "$i": { ".validate": "newData.isNumber()" } },
          "t": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
